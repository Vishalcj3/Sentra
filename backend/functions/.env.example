# Copy to backend/functions/.env and fill in. Never commit the real .env.
GEMINI_API_KEY=
DEMO_MODE=true

# Chroma Cloud — RAG knowledge vector store
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=Vortexa
# "false" forces the offline in-memory knowledge base
RAG_USE_CHROMA=true

# Pepper for patient credential hashing (patientAuth.js)
AUTH_PEPPER=
